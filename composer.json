{
  "name": "wexample/symfony-remote-payment",
  "description": "Payment provider contracts: collect payments, read webhooks, read the merchant balance for bookkeeping",
  "type": "library",
  "license": "MIT",
  "version": "3.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemotePayment\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemotePayment\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-remote": ">=2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}